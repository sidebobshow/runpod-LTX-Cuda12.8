FROM runpod/comfyui:cuda12.8
SHELL ["/bin/bash", "-lc"]

# Rename original start.sh so start-wrapper.sh can call it
RUN mv /start.sh /start.sh.base

# Patch original start.sh script so ComfyUI + pip warmup always use venv python
RUN sed -i \
  -e 's|^time python -m pip --version|time "$VENV_DIR/bin/python" -m pip --version|' \
  -e 's|^python main\.py |"$VENV_DIR/bin/python" main.py |' \
  /start.sh.base

# Change comfyui install destination to /opt/runpod-slim stop it being loaded to persistent storage
RUN sed -i \
  -e 's|^COMFYUI_DIR="/workspace/runpod-slim/ComfyUI"$|COMFYUI_DIR="/opt/runpod-slim/ComfyUI"|' \
  /start.sh.base

# Install custom nodes via script
COPY install-custom-nodes.charactersheet /opt/install-custom-nodes.sh
RUN chmod +x /opt/install-custom-nodes.sh && /opt/install-custom-nodes.sh

# Add ComfyUI paths pointing to global volume via yaml
COPY extra_model_paths.yaml /opt/comfyui-baked/extra_model_paths.yaml

# Wrapper entrypoint: runs /workspace/start.sh if present, then execs /start.sh.base
COPY start-wrapper.sh /start.sh
RUN chmod +x /start.sh
