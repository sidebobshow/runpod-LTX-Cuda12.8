FROM runpod/comfyui:cuda12.8
SHELL ["/bin/bash", "-lc"]

# Rename upstream entrypoint so our wrapper can call it
RUN mv /start.sh /start.sh.base

# Patch upstream start script so ComfyUI + pip warmup always use venv python
RUN sed -i \
  -e 's|^time python -m pip --version|time "$VENV_DIR/bin/python" -m pip --version|' \
  -e 's|^python main\.py |"$VENV_DIR/bin/python" main.py |' \
  /start.sh.base

# Install Ollama - fails on dependencies - fix if wanting to use
#RUN apt-get update && apt-get install -y --no-install-recommends \
#      curl ca-certificates \
#    && rm -rf /var/lib/apt/lists/* \
#    && curl -fsSL https://ollama.com/install.sh | sh

# Build-time install of custom nodes via script
#COPY install-custom-nodes.sh /opt/install-custom-nodes.sh
#RUN chmod +x /opt/install-custom-nodes.sh && /opt/install-custom-nodes.sh

# Add model paths for global volume
COPY extra_model_paths.yaml /opt/comfyui-baked/extra_model_paths.yaml

# Wrapper entrypoint: runs /workspace/start.sh if present, then execs /start.sh.base
COPY start-wrapper.sh /start.sh
RUN chmod +x /start.sh
