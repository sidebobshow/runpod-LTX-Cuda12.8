#!/usr/bin/env bash
set -e

COMFY_BAKED_DIR="/opt/comfyui-baked"
CUSTOM_NODES_DIR="${COMFY_BAKED_DIR}/custom_nodes"

mkdir -p "$CUSTOM_NODES_DIR"
cd "$CUSTOM_NODES_DIR"

############## Custom Nodes #############

## GGUF loader
# git clone --depth 1 https://github.com/molbal/ComfyUI-GGUF
git clone --depth 1 https://github.com/ChrisColeTech/ComfyUI-GGUF-Loader

# BFS needed for face ID
git clone --depth 1 https://github.com/alisson-anjos/ComfyUI-BFSNodes bfsnodes

# ComfyUI-CustomVideoSave / [ Called confusingly Video Combine (Custom Path)]
# Saves video, fnl images, prompt, workflow json. No video combine 
git clone --depth 1 https://github.com/Slartibart23/ComfyUI-CustomVideoSave

# Load and save image from path
git clone --depth 1 https://github.com/Ryuukeisyou/comfyui_io_helpers

# Load video from path
# git clone --depth 1 https://github.com/rookiestar28/ComfyUI-VideoHelper-Adv

# Load video and output video (not image batch)
git clone --depth 1 https://github.com/ChrisColeTech/ComfyUI-Get-Random-File

# Load and save text (no cache)
git clone --depth 1 https://github.com/steelan9199/ComfyUI-Teeth

# Load and save text
git clone --depth 1 https://github.com/watarika/ComfyUI-Text-Utility

# Smart switches
git clone --depth 1 https://github.com/rgthree/rgthree-comfy

# VHS
git clone --depth 1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite comfyui-videohelpersuite

# Preview video
# git clone https://github.com/elgalardi/ComfyUI-PreviewVideo

# Bjornulf custom nodes
# git clone --depth 1 https://github.com/Bjornulf/ComfyUI_Bjornulf_CustomNodes.git bjornulf_custom_nodes

########## Dependencies ##########

### basic requirements
python3 -m pip install --no-cache-dir -U pip setuptools wheel

### node requirements
BLACKLIST_RE='^(torch|torchvision|torchaudio|google-genai|qwen-tts|omnivoice|gradio|tensorboardx|webdataset)$'

for req in /opt/comfyui-baked/custom_nodes/*/requirements.txt; do
  [ -f "$req" ] || continue
  echo "Installing $req"

  # Strip comments/blank lines, then drop blacklisted pkgs (exact name match)
  awk 'NF && $1 !~ /^#/' "$req" \
    | sed 's/[[:space:]].*$//' \
    | grep -vE "$BLACKLIST_RE" \
    | python3 -m pip install --no-cache-dir -r /dev/stdin
done
