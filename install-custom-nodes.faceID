#!/usr/bin/env bash
set -e

COMFY_BAKED_DIR="/opt/comfyui-baked"
CUSTOM_NODES_DIR="${COMFY_BAKED_DIR}/custom_nodes"

mkdir -p "$CUSTOM_NODES_DIR"
cd "$CUSTOM_NODES_DIR"

git clone --depth 1 https://github.com/alisson-anjos/ComfyUI-BFSNodes bfsnodes
git clone --depth 1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite comfyui-videohelpersuite
git clone --depth 1 https://github.com/city96/ComfyUI-GGUF ComfyUI-GGUF

python3 -m pip install --no-cache-dir -U pip setuptools wheel

python3 -m pip install --no-cache-dir -r "${CUSTOM_NODES_DIR}/bfsnodes/requirements.txt"
python3 -m pip install --no-cache-dir -r "${CUSTOM_NODES_DIR}/comfyui-videohelpersuite/requirements.txt"
python3 -m pip install --no-cache-dir -r "${CUSTOM_NODES_DIR}/ComfyUI-GGUF/requirements.txt"
