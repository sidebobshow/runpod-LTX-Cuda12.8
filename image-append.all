FROM sidebobshow/comfyui:base
SHELL ["/bin/bash", "-lc"]

###### Append Start Script ########

# Rename original start.sh so our wrapper can call it
RUN mv /start.sh /start.sh.base
# Wrapper entrypoint: runs /workspace/start.sh if present, then execs /start.sh.base
COPY start-wrapper.sh /start.sh
RUN chmod +x /start.sh

# Patch original start script so ComfyUI + pip warmup always use venv python
RUN sed -i \
  -e 's|^time python -m pip --version|time "$VENV_DIR/bin/python" -m pip --version|' \
  -e 's|^python main\.py |"$VENV_DIR/bin/python" main.py |' \
  /start.sh.base
# Change comfyui install destination to /opt/runpod-slim stop it being loaded to persistent storage
RUN sed -i \
  -e 's|^COMFYUI_DIR="/workspace/runpod-slim/ComfyUI"$|COMFYUI_DIR="/opt/runpod-slim/ComfyUI"|' \
  /start.sh.base

RUN rm -f /opt/comfyui-baked/default_workflow.json

######## Models Paths ########

# Add model paths for global volume
COPY extra_model_paths.yaml /opt/comfyui-baked/extra_model_paths.yaml

######## Other Paths #########
# Default comfyui checks /workflow/runpod-slim/comfyui_args.txt
# --user-directory /workspace/user
# --output-directory /workspace/output
# --input-directory /workspace/output/input


######## Custom Nodes #########

# Build-time install of custom nodes via script
COPY install-custom-nodes.all /opt/install-custom-nodes.sh
RUN chmod +x /opt/install-custom-nodes.sh && /opt/install-custom-nodes.sh

######## Dependencies ##########

# Install Ollama - fails on dependencies - fix if wanting to use
#RUN apt-get update && apt-get install -y --no-install-recommends \
#      curl ca-certificates \
#    && rm -rf /var/lib/apt/lists/* \
#    && curl -fsSL https://ollama.com/install.sh | sh

